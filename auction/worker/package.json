{
  "name": "obavia-auction-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor": "node -e \"const fs=require('fs');fs.mkdirSync('assets/pdfjs',{recursive:true});for(const f of ['pdf.min.mjs','pdf.worker.min.mjs'])fs.copyFileSync('node_modules/pdfjs-dist/build/'+f,'assets/pdfjs/'+f)\"",
    "predev": "npm run vendor",
    "dev": "wrangler dev",
    "predeploy": "npm run vendor",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run vendor",
    "test": "vitest run",
    "migrate": "wrangler d1 migrations apply obavia-auction --local"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^4.20250101.0",
    "pdfjs-dist": "4.10.38",
    "typescript": "~5.9.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.149.0"
  }
}
