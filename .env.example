# Apohenia Sales OS — environment placeholders
#
# INCREMENT 1 NEEDS NONE OF THESE. The app runs in local demo mode with synthetic
# data stored in the browser and cannot dial, transcribe, or call any model.
# Every variable below is reserved for a LATER increment. Leave this file as-is;
# copy it to `.env.local` only when that increment is actually being built.
# Never commit a real value.
#
# --- Increment 2: Supabase (secure persistence, auth, RLS) ---
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=            # server-only, never exposed to the browser
#
# --- Increment 3: Twilio Programmable Voice (one consented human call) ---
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_TWIML_APP_SID=
# TWILIO_CALLER_ID=                     # a number the workspace is authorized to present
# PUBLIC_CALLBACK_URL=                  # externally visible base URL for signed webhooks
#
# --- Increment 4/5: OpenAI (structured coaching, browser voice roleplay) ---
# OPENAI_API_KEY=                       # server-only
