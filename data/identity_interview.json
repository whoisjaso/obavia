      "summary_label": "Chosen standards",
      "kind": "multi",
      "max_select": 4,
      "options": [
        {
          "id": "std_prepare",
          "label": "I prepare",
          "description": "I rehearse the approved opening and one branch before I talk to anyone."
        },
        {
          "id": "std_one_question",
          "label": "I ask one clear question at a time",
          "description": "One question, then I stop and wait."
        },
        {
          "id": "std_listen_first",
          "label": "I listen before I answer",
          "description": "I let the answer finish before the next line."
        },
        {
          "id": "std_follow_script",
          "label": "I follow the script until I have earned the right to vary it",
          "description": "Exact words first; variation later."
        },
        {
          "id": "std_respect_no_fit",
          "label": "I respect a no-fit case",
          "description": "Ending politely when there is no gap."
        },
        {
          "id": "std_call_before_build",
          "label": "I make the call before I build the tool",
          "description": "Conversations first; software after."
        },
        {
          "id": "std_keep_word",
