{
  "id": "identity-interview",
  "version": 1,
  "title": "Identity interview",
  "screens": [
    {
      "id": "goal_meaning",
      "order": 0,
      "prompt": "What is the billion-dollar ambition for?",
      "help": "Your own words for the purpose behind the number. This is context you describe, not something the app infers. Choose up to 3.",
      "summary_label": "What the ambition is for",
      "kind": "multi",
      "max_select": 3,
      "options": [
        {
          "id": "goal_durable",
          "label": "Building something that outlasts me",
          "description": "A company that keeps working without my hands on it."
        },
        {
          "id": "goal_provide",
          "label": "Providing for the people I am responsible for",
          "description": "Family, team, community."
        },
        {
          "id": "goal_freedom",
          "label": "Freedom to choose how I spend my time",
          "description": "Ownership of my calendar and my attention."
        },
        {
          "id": "goal_proof",
          "label": "Proof of what is possible",
          "description": "Showing what can be built from where I started."
        },
        {
          "id": "goal_purpose",
          "label": "Serving a purpose larger than the business",
          "description": "The number is a means, not the point."
        },
        {
          "id": "goal_fund",
          "label": "Funding work I believe in",
          "description": "Capital for causes, people or projects that matter to me."
        }
      ],
      "allow_skip": true,
      "uncertainty_option": {
        "id": "goal_meaning.unsure",
        "label": "I'm not sure yet"
      },
      "none_option": {
        "id": "goal_meaning.none",
        "label": "None of these"
      },
      "profile_field": "success_definitions",
      "base_or_conditional": "base"
    },
    {
      "id": "success_business",
      "order": 1,
      "prompt": "This year, business success looks like which of these?",
      "help": "Pick the one that would most clearly tell you the year worked.",
      "summary_label": "Business success this year",
      "kind": "single",
      "options": [
        {
          "id": "biz_repeatable_conversation",
          "label": "A repeatable sales conversation I can run from memory",
          "description": "The script is internalized, transitions are smooth."
        },
        {
          "id": "biz_first_approved_sale",
          "label": "A first approved offer sold to a real dealership",
          "description": "Real scope, real terms, delivered as promised."
        },
        {
          "id": "biz_pipeline",
          "label": "A steady pipeline of real conversations",
          "description": "Enough at-bats to learn from, every week."
        },
        {
          "id": "biz_revenue_figure",
          "label": "A specific revenue figure I have set for myself",
          "description": "A number you already know; the app does not need it."
        },
        {
          "id": "biz_team_sells",
          "label": "A team that can sell without me",
          "description": "The process works in other hands."
        }
      ],
      "allow_skip": true,
      "uncertainty_option": {
        "id": "success_business.unsure",
        "label": "I'm not sure yet"
      },
      "none_option": {
        "id": "success_business.none",
        "label": "None of these"
      },
      "profile_field": "success_definitions",
      "base_or_conditional": "base"
    },
    {
      "id": "success_personal",
      "order": 2,
      "prompt": "Personal success this year looks like which of these?",
      "summary_label": "Personal success this year",
      "kind": "multi",
      "max_select": 2,
      "options": [
        {
          "id": "pers_presence",
          "label": "Being present with the people I love",
          "description": "Work stays in its lane."
        },
        {
          "id": "pers_health",
          "label": "Health and energy that hold up",
          "description": "Sustainable pace, ordinary rest."
        },
        {
          "id": "pers_integrity",
          "label": "Doing what I said I would do",
          "description": "Word and action match."
        },
        {
          "id": "pers_growth",
          "label": "Learning a skill I did not have before",
          "description": "Selling, specifically."
        },
        {
          "id": "pers_peace",
          "label": "A calmer mind",
          "description": "Fewer open loops, clearer days."
        }
      ],
      "allow_skip": true,
      "uncertainty_option": {
        "id": "success_personal.unsure",
        "label": "I'm not sure yet"
      },
      "none_option": {
        "id": "success_personal.none",
        "label": "None of these"
      },
      "profile_field": "success_definitions",
      "base_or_conditional": "base",
      "help": "Choose up to 2."
    },
    {
      "id": "faith_context",
      "order": 3,
      "prompt": "How does your faith relate to this work?",
      "help": "Self-described context only. Nothing here is interpreted or scored. Choose up to 3.",
      "summary_label": "Faith as context",
      "kind": "multi",
      "max_select": 3,
      "options": [
        {
          "id": "faith_reason",
          "label": "It is the reason behind the goal",
          "description": "The purpose comes first; the business serves it."
        },
        {
          "id": "faith_people",
          "label": "It shapes how I treat people",
          "description": "Including prospects who say no."
        },
        {
          "id": "faith_identity",
          "label": "It is part of who I am and hard to separate from work",
          "description": "It shows up whether I plan it or not."
        },
        {
          "id": "faith_private",
          "label": "It is a private practice, separate from work",
          "description": "Important to me, kept apart from the business."
        }
      ],
      "allow_skip": true,
      "uncertainty_option": {
        "id": "faith_context.unsure",
        "label": "I'm not sure yet"
      },
      "none_option": {
        "id": "faith_context.none",
        "label": "None of these"
      },
      "profile_field": "success_definitions",
      "base_or_conditional": "base"
    },
    {
      "id": "faith_practice_standard",
      "order": 4,
      "prompt": "How does your faith show up as a practice standard?",
      "help": "A standard you choose for yourself. It becomes part of your training plan only if you endorse it.",
      "summary_label": "Faith as a practice standard",
      "kind": "single",
      "options": [
        {
          "id": "faithstd_keep_word",
          "label": "I keep my word: the drill I said I would do is the drill I do",
          "description": "Faithfulness in small, repeated things."
        },
        {
          "id": "faithstd_dignity",
          "label": "I treat every prospect with dignity, including when the answer is no",
          "description": "A no-fit case is handled with the same respect."
        },
        {
          "id": "faithstd_truth",
          "label": "I tell the truth about what I can deliver",
          "description": "No claim goes out that I cannot back."
        },
        {
          "id": "faithstd_rest",
          "label": "I rest one day a week",
          "description": "Practice pauses without erasing anything."
        },
        {
          "id": "faithstd_quiet",
          "label": "I start each session with a moment of quiet",
          "description": "A short pause before the first line."
        }
      ],
      "allow_skip": true,
      "uncertainty_option": {
        "id": "faith_practice_standard.unsure",
        "label": "I'm not sure yet"
      },
      "none_option": {
        "id": "faith_practice_standard.none",
        "label": "None of these"
      },
      "condition": {
        "screen_id": "faith_context",
        "any_of": [
          "faith_reason",
          "faith_people",
          "faith_identity"
        ]
      },
      "profile_field": "chosen_standards",
      "base_or_conditional": "conditional"
    },
    {
      "id": "beliefs_selling",
      "order": 5,
      "prompt": "What do you currently believe about selling?",
      "help": "Current beliefs, not the beliefs you think you should have. Choose up to 3.",
      "summary_label": "Current beliefs about selling",
      "kind": "multi",
      "max_select": 3,
      "options": [
        {
          "id": "bel_helping_decide",
          "label": "It is helping someone decide",
          "description": "Questions that bring the real situation into view."
        },
        {
          "id": "bel_numbers",
          "label": "It is mostly a numbers game",
          "description": "Volume of attempts is what matters most."
        },
        {
          "id": "bel_right_order",
          "label": "It is asking the right questions in the right order",
          "description": "Sequence matters as much as words."
        },
        {
          "id": "bel_still_learning_trust",
          "label": "It is something I am still learning to trust",
          "description": "The process works for others; I am proving it for myself."
        },
        {
          "id": "bel_performance",
          "label": "It is a performance I put on",
          "description": "A role I put on for the call."
        },
        {
          "id": "bel_repetition_skill",
          "label": "It is a skill built by repetition",
          "description": "Like call-center work: reps first, fluency after."
        }
      ],
      "allow_skip": true,
      "uncertainty_option": {
        "id": "beliefs_selling.unsure",
        "label": "I'm not sure yet"
      },
      "none_option": {
        "id": "beliefs_selling.none",
        "label": "None of these"
      },
      "profile_field": "beliefs",
      "base_or_conditional": "base"
    },
    {
      "id": "beliefs_self",
      "order": 6,
      "prompt": "What do you believe about yourself as a seller right now?",
      "summary_label": "Belief about myself as a seller",
      "kind": "single",
      "options": [
        {
          "id": "self_learn_like_before",
          "label": "I can learn this the way I learned call-center work",
          "description": "Repetition made call-center lines fluent for me before."
        },
        {
          "id": "self_know_freeze",
          "label": "I know the material but freeze at transitions",
          "description": "The words are there; the bridges between them are the hard part."
        },
        {
          "id": "self_strong_live_underprepared",
          "label": "I am strong live but under-prepared",
          "description": "Good in the moment, thin on rehearsal."
        },
        {
          "id": "self_builder",
          "label": "I am better at building than talking",
          "description": "The tool gets built before the call gets made."
        },
        {
          "id": "self_steady",
          "label": "I am steady and just need the reps",
          "description": "No drama; the work is the work."
        }
      ],
      "allow_skip": true,
      "uncertainty_option": {
        "id": "beliefs_self.unsure",
        "label": "I'm not sure yet"
      },
      "none_option": {
        "id": "beliefs_self.none",
        "label": "None of these"
      },
      "profile_field": "beliefs",
      "base_or_conditional": "base"
    },
    {
