{
  "permissions": {
    "allow": [
      "Read", "Edit", "Write", "Grep", "Glob",
      "Bash(npm test*)", "Bash(npm run *)", "Bash(npx vitest*)", "Bash(npx playwright*)",
      "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)", "Bash(git add *)", "Bash(git commit *)"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git reset --hard*)", "Bash(rm -rf /*)",
      "Read(.env)", "Read(.env.*)", "Read(**/*.pem)", "Read(**/*.key)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/block-destructive.sh" },
          { "type": "command", "command": "bash .claude/hooks/block-secrets.sh" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/session-banner.sh" }
        ]
      }
    ]
  }
}
